#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">To configure this button to open your chat service, open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Chat URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">Per configurare questo pulsante per aprire il tuo servizio di chat, apri <b>Modifica &rsaquo; Preferenze &rsaquo; Collegamenti rapidi</b> e imposta l’<b>URL della chat</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">To configure this button to open your Git forge (for example GitHub, GitLab or Gitea), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Git URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">Per configurare questo pulsante per aprire il tuo servizio Git (ad esempio GitHub, GitLab o Gitea), apri <b>Modifica &rsaquo; Preferenze &rsaquo; Collegamenti rapidi</b> e imposta l’<b>URL Git</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Mail</h2><p style=\"margin-bottom:0;\">To configure this button to open your mail link (for example Gmail or webmail), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Mail URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Posta</h2><p style=\"margin-bottom:0;\">Per configurare questo pulsante per aprire la tua posta (ad esempio Gmail o webmail), apri <b>Modifica &rsaquo; Preferenze &rsaquo; Collegamenti rapidi</b> e imposta l’<b>URL della posta</b>.</p></div>"

